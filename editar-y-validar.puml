@startuml
skinparam style strictuml
skinparam actorStyle awesome
left to right direction

actor "Usuario" as user

control core as "Controlador de receta"
entity recipe as "Modelo de receta"
control valid as "Validación"

boundary editor as "Editor de recetas"



user -- editor
core -- recipe
valid -- recipe
editor -- core
editor -- valid
'valid -- editor
@endum